out=Table[{w,a,Round[ci[rm[a][w]],0.0001],If[a=="omega",Null,Round[ci[rm["omega"][w]/rm[a][w]],0.0001]]},{w,Keys[by]},{a,Keys[dat]}];
mem=Table[{a,ci[rss[a]],Round[ci[cpuS[a]/40.*1000],0.0001]},{a,Keys[dat]}];
ExportString[{out,mem},"JSON","Compact"->True]
